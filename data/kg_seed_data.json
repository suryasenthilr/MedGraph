    { "source": "M001", "target": "M002", "type": "INTERACTS_WITH", "severity": "MAJOR", "description": "Concomitant use of Warfarin and Ibuprofen markedly increases the risk of severe upper gastrointestinal bleeding and hemorrhage due to combined anti-platelet/COX-1 inhibition and anticoagulant effects." },
