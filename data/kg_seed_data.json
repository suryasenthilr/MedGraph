    { "source": "M002", "target": "M005", "type": "INTERACTS_WITH", "severity": "MODERATE", "description": "NSAIDs blunt the antihypertensive effect of ACE inhibitors and together precipitate acute renal hemodynamic impairment (triple whammy risk)." },

