# MedGraph Environment Configuration

# Groq Cloud API Key (Required for LLM inference)
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Cascade (Recommended: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# Knowledge Graph Database Backend (memory or neo4j)
KG_BACKEND=memory

# Neo4j Graph Database (Optional: Only if KG_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
